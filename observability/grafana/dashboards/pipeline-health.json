        "x": 12,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "spark_streaming_state_rows{query=\"orders_per_minute\"}",
          "legendFormat": "windows in state",
          "refId": "A"
        }
      ]
    },
