{
  "uid": "pipeline-health",
  "title": "Pipeline health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "lakehouse"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Bronze Kafka lag by topic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Spark listener: broker end minus last batch end (ADR-013). 0 at rest.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (spark_streaming_kafka_lag{query=\"bronze_cdc_ingest\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Bronze rows per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(spark_streaming_input_rows_total{query=\"bronze_cdc_ingest\"}[5m])",
          "legendFormat": "rows/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Bronze batch duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "spark_streaming_batch_duration_seconds{query=\"bronze_cdc_ingest\"}",
          "legendFormat": "batch",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Seconds since the last bronze batch",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alert SparkNoBatch5m at 300 s. Idle events also move it.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - spark_streaming_last_batch_timestamp{query=\"bronze_cdc_ingest\"}",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Connector task status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "JMX agent in Connect: 1 for the current status.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kafka_connect_connector_task_status{connector=\"shop-connector\"}",
          "legendFormat": "{{status}} task {{task}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Debezium behind source",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "-1 until the first event after a start.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "debezium_postgres_streaming_MilliSecondsBehindSource",
          "legendFormat": "ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "WAL retained by the slot",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alert SlotWalRetainedHigh: over 64 MiB with the slot inactive, or over 512 MiB.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_slot_retained_bytes",
          "legendFormat": "{{slot_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Slot active",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 while a walsender holds the slot.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_slot_active",
          "legendFormat": "{{slot_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Silver lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alert FreshnessAbove15m at 900 s. 0 at rest.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_silver_lag_seconds",
          "legendFormat": "oldest unmerged bronze snapshot",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Table freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Grows between replay bursts: no traffic, not a fault. Steps every 15 min.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_table_freshness_seconds",
          "legendFormat": "{{layer}} {{table}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "DQ: duplicate keys and reconcile",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(lakehouse_dq_silver_duplicate_keys)",
          "legendFormat": "duplicate keys",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_dq_reconcile_tables_differing",
          "legendFormat": "tables differing (at_rest={{at_rest}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "DQ: delivery repeats and no-op updates, last hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
