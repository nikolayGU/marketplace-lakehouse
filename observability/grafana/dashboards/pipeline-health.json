          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lakehouse_dq_noop_updates_last_hour",
          "legendFormat": "no-op updates",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "title": "silver_upsert and other task durations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (dag_id, task_id) (rate(airflow_task_duration_seconds_sum[1h]) / rate(airflow_task_duration_seconds_count[1h]))",
          "legendFormat": "{{dag_id}}.{{task_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Failed Airflow tasks, last hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(airflow_ti_finish_total{state=\"failed\"}[1h])) or vector(0)",
