        "x": 0,
        "y": 49,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(airflow_dagrun_failed_seconds_count) or vector(0)",
          "legendFormat": "failed runs since statsd-exporter start",
          "refId": "A"
        }
      ]
