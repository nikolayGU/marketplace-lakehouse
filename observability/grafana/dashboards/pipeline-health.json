      "id": 17,
      "title": "orders_per_minute: watermark",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Event time of the data, not the clock: a date far from now is the replay's virtual time.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "spark_streaming_watermark_timestamp_seconds{query=\"orders_per_minute\"} * 1000",
          "legendFormat": "watermark",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "orders_per_minute: rows dropped by the watermark, last hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
