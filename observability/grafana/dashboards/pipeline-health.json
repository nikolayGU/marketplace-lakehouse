    {
      "id": 16,
      "title": "orders_per_minute: rows in state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Open one-minute windows; grows with the watermark delay, evicted behind it.",
