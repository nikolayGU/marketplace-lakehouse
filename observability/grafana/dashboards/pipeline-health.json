      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(spark_streaming_late_rows_dropped_total{query=\"orders_per_minute\"}[1h])",
          "legendFormat": "dropped",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "title": "orders_per_minute: input rows per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spark_streaming_input_rows_total{query=\"orders_per_minute\"}[5m]))",
          "legendFormat": "rows/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Reconcile: values differing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Source against silver and silver against gold, by row fingerprint, at rest only (W5-T04). 0 everywhere.",
