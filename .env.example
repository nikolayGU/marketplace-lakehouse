# Copy to .env via `make secrets` (generates passwords). Never commit .env.

COMPOSE_PROJECT_NAME=lakehouse
BIND_IP=127.0.0.1
DATA_DIR=./data

# OLTP source (CDC)
OLTP_DB=shop
OLTP_USER=shop
OLTP_PASSWORD=change_me
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=change_me

# Metadata Postgres: airflow, lakekeeper, superset
META_USER=meta
META_PASSWORD=change_me
AIRFLOW_DB=airflow
LAKEKEEPER_DB=lakekeeper
SUPERSET_DB=superset

# Kafka
KAFKA_HEAP=-Xmx768m
CONNECT_HEAP=-Xmx1g
KAFKA_RETENTION_HOURS=24
KAFKA_PARTITIONS=3

# Object storage
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=lakehouse
S3_ENDPOINT=http://minio:9000

# Iceberg catalog: jdbc (week 1) or rest (after Lakekeeper is adopted)
CATALOG_TYPE=jdbc
CATALOG_DB=iceberg_catalog
LAKEKEEPER_URI=http://lakekeeper:8181/catalog
LAKEKEEPER_WAREHOUSE=lake

# Spark
SPARK_DRIVER_MEMORY=1500m
SPARK_MASTER=local[2]
BRONZE_TRIGGER_SECONDS=20
BRONZE_MAX_OFFSETS_PER_TRIGGER=20000

# Trino
TRINO_XMX=2500m

# Replayer
REPLAY_SPEED=2880           # virtual seconds per real second (1 day per 30 s)
REPLAY_INITIAL_SHARE=0.8    # share of history bulk-loaded before streaming
REPLAY_LATE_RATIO=0
REPLAY_LATE_DELAY_SECONDS=300
REPLAY_DUPLICATE_RATIO=0
REPLAY_SCHEMA_EVOLUTION_AT=  # virtual timestamp to apply migration 002, empty = never

# Airflow
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_ADMIN_PASSWORD=change_me

# Grafana / Superset
GRAFANA_ADMIN_PASSWORD=change_me
SUPERSET_SECRET_KEY=change_me
