+        (SUBSTITUTED_STAMP + "nice" + " -a 0.5" * 40 + ' python3)"', "deny"),
+        (SUBSTITUTED_STAMP + "nice" + " -a 1.5s" * 40 + ' python3)"', "deny"),
+        (SUBSTITUTED_STAMP + "nice" + " -a A=1" * 40 + ' python3)"', "deny"),
+        (SUBSTITUTED_STAMP + "nice" + " -a A=1 nice" * 40 + ' python3)"', "deny"),
