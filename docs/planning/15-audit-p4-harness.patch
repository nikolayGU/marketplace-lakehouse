+
+@pytest.mark.parametrize("path", ODD_DOC_PATHS)
+def test_a_doc_with_a_space_or_a_non_ascii_name_is_no_code_change(repo: Path, path: str) -> None:
+    (repo / path).parent.mkdir(exist_ok=True)
