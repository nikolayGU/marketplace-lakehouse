+    text = ENV_FILE_OPTION.sub(" ", command)
+    if INLINE_CODE.search(text) and ENV_TEXT.search(text):
+        return SECRET_ENV
+    for found in SUBSTITUTION.finditer(command):
+        reason = secret_shown(found[1] or found[2] or "")
+        if reason:
